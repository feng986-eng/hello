from collections import Counter
import re

text = input("请输入一段文本：").lower()  # 转小写
words = re.findall(r'\b\w+\b', text)    # 提取所有单词（忽略标点）
word_count = Counter(words)              # 统计词频

print("\n词频统计结果：")
for word, count in word_count.most_common():  # 按出现次数排序
    print(f"{word}: {count}次")

